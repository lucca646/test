{
  "expo": {
    "name": "COR·ALT",
    "slug": "liquid-glass-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "coralt",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "eu.coraia.liquidglass.dev",
      "infoPlist": {
        "CFBundleDisplayName": "COR·ALT",
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Zone de test caméra / flash dans l’onglet Apps.",
        "NSFaceIDUsageDescription": "Zone de test Face ID dans l’onglet Apps.",
        "NSMicrophoneUsageDescription": "Optionnel pour tests caméra vidéo.",
        "NSSupportsLiveActivitiesFrequentUpdates": false
      },
      "entitlements": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080a1c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "eu.coraia.liquidglass.dev",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-live-activity",
      [
        "expo-camera",
        {
          "cameraPermission": "Zone de test caméra / flash dans l’onglet Apps.",
          "microphonePermission": "Optionnel pour tests caméra vidéo.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Zone de test Face ID dans l’onglet Apps."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "luccar2956s-team",
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "LiveActivity",
                  "bundleIdentifier": "eu.coraia.liquidglass.dev.LiveActivity",
                  "entitlements": {}
                }
              ]
            }
          }
        },
        "projectId": "cfec5576-6c42-4ead-b311-2e85c207cb33"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cfec5576-6c42-4ead-b311-2e85c207cb33",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    }
  }
}
