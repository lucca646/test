{
  "expo": {
    "name": "Liquid Glass",
    "slug": "liquid-glass-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "liquidglass",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "eu.coraia.liquidglass.dev",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050508",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "eu.coraia.liquidglass.dev",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-live-activity"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "luccar2956s-team",
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "LiveActivity",
                  "bundleIdentifier": "eu.coraia.liquidglass.dev.LiveActivity",
                  "entitlements": {}
                }
              ]
            }
          }
        },
        "projectId": "cfec5576-6c42-4ead-b311-2e85c207cb33"
      }
    }
  }
}
