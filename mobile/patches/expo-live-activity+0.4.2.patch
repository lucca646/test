+/// Résout le layout effectif + textes (compat protocole "12|16" dans title).
+private struct IslandKit {
+  let layout: String
+  let leading: String?
+  let trailing: String?
+  let leadingLabel: String?
+  let trailingLabel: String?
+  let center: String?
+  let bottom: String?
+  let badge: String?
+  let title: String
+  let subtitle: String?
+
+  init(state: LiveActivityAttributes.ContentState) {
+    title = state.title
+    subtitle = state.subtitle
+    badge = state.badgeText
+    center = state.centerText
+    bottom = state.bottomText ?? state.subtitle
+
+    // Protocole legacy score: "12|16"
+    if let pipe = Self.parsePipe(state.title) {
+      layout = state.layout ?? "score"
+      leading = state.leadingText ?? pipe.0
+      trailing = state.trailingText ?? pipe.1
+      leadingLabel = state.leadingLabel ?? "COR"
+      trailingLabel = state.trailingLabel ?? "ALT"
+      return
+    }
+
+    layout = state.layout ?? "default"
+    leading = state.leadingText
+    trailing = state.trailingText
+    leadingLabel = state.leadingLabel
+    trailingLabel = state.trailingLabel
+  }
+
+  var isSideNumbers: Bool {
+    switch layout {
+    case "score", "dual", "sides":
+      return leading != nil && trailing != nil
+    default:
+      return false
+    }
+  }
+
+  /// Layouts qui ne doivent JAMAIS afficher de barre linéaire.
+  var rejectsLinearBar: Bool {
+    switch layout {
+    case "score", "dual", "sides", "transport", "music", "breathe", "focus", "timer", "minimal":
+      return true
+    default:
+      return false
+    }
+  }
+
+  private static func parsePipe(_ title: String) -> (String, String)? {
+    let parts = title.split(separator: "|", omittingEmptySubsequences: false)
+    guard parts.count == 2 else { return nil }
+    let a = parts[0].trimmingCharacters(in: .whitespaces)
+    let b = parts[1].trimmingCharacters(in: .whitespaces)
+    guard !a.isEmpty, !b.isEmpty, a.allSatisfy(\.isNumber), b.allSatisfy(\.isNumber) else {
+      return nil
+    }
+    return (a, b)
+  }
+}
