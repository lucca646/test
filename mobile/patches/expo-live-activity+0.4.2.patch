+/// Protocole JS : title = "12|16" → scores à gauche / droite de l’île.
+private struct ScorePair {
+  let home: String
+  let away: String
+
+  static func parse(_ title: String) -> ScorePair? {
+    let parts = title.split(separator: "|", omittingEmptySubsequences: false)
+    guard parts.count == 2 else { return nil }
+    let home = parts[0].trimmingCharacters(in: .whitespaces)
+    let away = parts[1].trimmingCharacters(in: .whitespaces)
+    guard !home.isEmpty, !away.isEmpty,
+          home.allSatisfy({ $0.isNumber }),
+          away.allSatisfy({ $0.isNumber })
+    else { return nil }
+    return ScorePair(home: home, away: away)
+  }
+}
