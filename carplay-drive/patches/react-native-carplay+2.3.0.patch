+#pragma mark - Patch COR·ALT : construction de template non fatale
+//
+// Les classes CPTemplate sont annotées `main-thread-only` dans le SDK iOS 26
+// (`#define CARPLAY_TEMPLATE_UI_ACTOR NS_SWIFT_UI_ACTOR
+// __attribute__((annotate("main-thread-only")))`), et `-methodQueue` ci-dessus
+// demande bien le main queue — mais sous bridgeless la couche d'interop
+// TurboModule l'ignore : le crash observé montre l'invocation sur
+// `com.meta.react.turbomodulemanager.queue`. Une NSException levée là remonte
+// jusqu'à `ObjCTurboModule::performVoidMethodInvocation`, qui la relance
+// (`objc_exception_rethrow`) hors de tout @catch : `abort()`, sans message
+// exploitable dans le rapport de crash.
+//
+// On isole donc la construction : l'exception est capturée et renvoyée à JS
+// sous forme d'évènement `templateError`. L'app reste debout et affiche la
+// raison exacte au lieu de disparaître.
 RCT_EXPORT_METHOD(createTemplate:(NSString *)templateId config:(NSDictionary*)config) {
+    @try {
+        [self rncpCreateTemplate:templateId config:config];
+    } @catch (NSException *exception) {
+        NSLog(@"[RNCarPlay] createTemplate %@ a levé %@ : %@", templateId, exception.name, exception.reason);
+        if (RNCPCanEmit(self)) {
+            [self sendEventWithName:@"templateError" body:@{
+                @"templateId": templateId ?: @"?",
+                @"type": [RCTConvert NSString:config[@"type"]] ?: @"?",
+                @"name": exception.name ?: @"?",
+                @"reason": exception.reason ?: @"?",
+            }];
+        }
+    }
+}
